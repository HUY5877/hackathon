# 黑客松信息聚合平台 - 环境变量模板
# 复制此文件为 .env 并填入真实值

# ── 应用基础 ──────────────────────────────
APP_NAME=黑客松信息聚合平台
APP_VERSION=0.1.0
DEBUG=True

# ── 服务端口 ──────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── 数据库 ────────────────────────────────
# 本地开发（SQLite）:
DATABASE_URL=sqlite+aiosqlite:///./hackathon.db
# 生产环境（PostgreSQL）:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hackathon
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/hackathon

# ── Redis（缓存 & Celery） ────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT 认证 ──────────────────────────────
# 生产环境务必替换为随机长字符串（>= 32 字符）
JWT_SECRET_KEY=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── LLM API（AI 数据清洗） ────────────────
# 阶跃星辰 Step API:
LLM_API_KEY=
LLM_API_BASE_URL=https://api.stepfun.com/v1
LLM_MODEL=step-1-8k

# ── 邮件服务（EDM） ───────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=

# ── 爬虫配置 ──────────────────────────────────────
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36
CRAWLER_REQUEST_DELAY=2.0
CRAWLER_PROXY_POOL=
CRAWLER_TIMEOUT=30.0
CRAWLER_MAX_RETRIES=3
CRAWLER_MAX_ITEMS_PER_PLATFORM=0
CRAWLER_UA_ROTATION=False
CRAWLER_LLM_CACHE_TTL=86400
CRAWLER_OUTPUT_DIR=crawl_output

# ── 跨域 ──────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
