# 黑客松平台 - 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# ── 数据库 ────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/hackathon
DATABASE_URL_SYNC=postgresql://postgres:your_password@localhost:5432/hackathon

# ── 调试 ──────────────────────────────────
DEBUG=true

